class Solution {
public:
    vector<int> nextGreaterElement(vector<int>& nums1, vector<int>& nums2) {
        vector<int> v(nums1.size());
        unordered_map<int,int> mp;
        for(int i=0;i<nums1.size();i++) {
            mp[nums1[i]]=(i+1);
        }
        stack<int> s;
        for(int i=0;i<nums2.size();i++) {
            while(!s.empty()&&nums2[s.top()]<nums2[i]) {
                int index=s.top();
                s.pop();
                if(mp[nums2[index]]!=0) v[mp[nums2[index]]-1]=nums2[i];
            }
            s.push(i);
        }
        if(!s.empty()) {
            while(!s.empty()) {
                int index=s.top();
                s.pop();
                if(mp[nums2[index]]!=0) v[mp[nums2[index]]-1]=-1;
            }
        }
        return v;
    }
};
