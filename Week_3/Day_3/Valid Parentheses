class Solution {
public:
    bool isValid(string s) {
        stack<int> st;
        map<char,int> mp;
        mp['(']=1;
        mp[')']=-1;
        mp['{']=2;
        mp['}']=-2;
        mp['[']=3;
        mp[']']=-3;
        for(int i=0;i<s.size();i++) {
            if(mp[s[i]]<0) {
                if(!st.empty()&&mp[s[i]]+st.top()==0) st.pop();
                else return false;
            } else st.push(mp[s[i]]);
        }
        if(st.empty()) return true;
        else return false; 
    }
};
