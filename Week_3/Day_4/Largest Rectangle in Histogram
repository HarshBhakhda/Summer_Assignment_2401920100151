class Solution {
public:
    int largestRectangleArea(vector<int>& heights) {
        int n=heights.size();
        stack<int> st;
        int area=INT_MIN;
        int i=0;
        for(i=0;i<n;i++) {
            while(!st.empty()&&heights[i]<=heights[st.top()]) {
                int index_prevtop=st.top();
                st.pop();
                if(!st.empty()) area=max(area,heights[index_prevtop]*(i-st.top()-1));
                else if(i!=0)area=max(area,heights[index_prevtop]*(i));
            }
            st.push(i);
        }
        while(!st.empty()) {
            int index_prevtop=st.top();
            st.pop();
            if(!st.empty()) area=max(area,heights[index_prevtop]*(i-st.top()-1));
            else area=max(area,heights[index_prevtop]*(i));
        }
        return area;
    }
};
