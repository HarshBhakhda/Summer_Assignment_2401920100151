class Solution {
public:
    string decodeString(string s) {
        stack<int> nst;
        stack<string> st;
        string cur = "";
        int n = 0;

        for (char c : s) {
            if (isdigit(c)) {
                n=n * 10+(c - '0');
            } else if (c == '[') {
                nst.push(n);
                st.push(cur);
                n = 0;
                cur = "";
            } else if (c == ']') {
                int t = nst.top();
                nst.pop();
                string ans = st.top();
                st.pop();
                while (t--) ans += cur;
                cur = ans;
            } else {
                cur += c;
            }
        }
        return cur;
    }
};
