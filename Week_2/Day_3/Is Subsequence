class Solution {
public:
    bool isSubsequence(string s, string t) {
        if(t.size()<s.size()) return 0;
        int ptr1=0,ptr2=0;
        while(ptr1<t.size()&&ptr2<s.size()) {
            if(t[ptr1]==s[ptr2]) {
                ptr1++;
                ptr2++;
            } else ptr1++;
        }
        if(ptr2==s.size()) return true;
        else return false;
    }
};
