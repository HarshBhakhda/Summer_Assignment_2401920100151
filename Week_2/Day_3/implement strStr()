class Solution {
public:
    int strStr(string haystack, string needle) {
        int ans=-1;
        for(int i=0;i<haystack.size();i++) {
            if(haystack.size()-i<needle.size()) break;
            int ptr=0;
            for(int j=0;j<needle.size();j++) {
                if(haystack[i+j]!=needle[j]) {ptr=1;break;}
            }
            if(ptr==0) {ans=i;break;}
        }
        return ans;
    }
};
