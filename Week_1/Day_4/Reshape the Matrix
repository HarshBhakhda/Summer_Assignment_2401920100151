class Solution {
public:
    vector<vector<int>> matrixReshape(vector<vector<int>>& mat, int r, int c) {
        int x=mat[0].size();
        if(mat.size()*x==r*c) {
            vector<vector<int>> v(r,vector<int>(c));
            int row=0,col=0;
            for(int i=0;i<mat.size();i++) {
                for(int j=0;j<x;j++) {
                    if(col>=c) {row++;col=0;} 
                    v[row][col++]=mat[i][j];
                }
            }
            return v;
        } else {
            return mat;
        }
    }
};
