bool is_Palindrome(string& s,int l,int r) {
    if(l>=r) return true;
    else return s[l]==s[r]&&is_Palindrome(s,l+1,r-1);
} 

class Solution {
public:
    bool isPalindrome(string s) {
        string ans="";
        for(int i=0;i<s.size();i++) {
            char t=tolower(s[i]);
            if((t>='a'&&t<='z')||(t>='0'&&t<='9')) ans+=t;
        }
        return is_Palindrome(ans,0,ans.size()-1);
    }
};
