class Solution {
public:
    double findMaxAverage(vector<int>& nums, int k) {
        int max_sum=INT_MIN,sum=0;
        for(int i=0;i<nums.size();i++) {
            sum+=nums[i];
            if(i>k-1) sum-=nums[i-k];
            if(i>=k-1) max_sum=max(max_sum,sum);
        }
        return ((double)max_sum/k);
    }
};
