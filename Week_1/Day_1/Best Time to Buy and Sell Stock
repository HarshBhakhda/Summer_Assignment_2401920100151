class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int minimum=INT_MAX,ans=INT_MIN;
        for(int i=0;i<prices.size();i++) {
            minimum=min(minimum,prices[i]);
            if(prices[i]-minimum>=0) {
                ans=max(ans,(prices[i]-minimum));
            }
        }
        return ans;
    }
};
